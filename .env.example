# Copy to .env.local. Only EXPO_PUBLIC_* values reach the app bundle, so never put secrets here.

# mock (default, no setup) | rest
EXPO_PUBLIC_BACKEND=mock

# Required for the REST backend. Must be HTTPS (http://localhost is allowed in development).
EXPO_PUBLIC_API_URL=

# Key of a provider registered in src/di/payment-providers.ts.
EXPO_PUBLIC_PAYMENT_PROVIDER=mock
